<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPS・位置情報の権限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service の権限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 記録中の通知（Android 13以降） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 記録中、他のアプリの上に緑の帯を重ねて表示する（設定で許可した場合のみ） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ネットワーク（地図タイルの取得） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GPSLoggerApplication"
        android:allowBackup="true"
        android:label="GPSLogger"
        android:theme="@style/Theme.GPSLogger"
        android:supportsRtl="true">

        <!--
            Google Maps APIキー。
            Google Cloud Console (https://console.cloud.google.com) で取得したキーを
            android/local.properties に MAPS_API_KEY=... として書くと、ビルド時に埋め込まれる。
            Google以外の地図はAPIキー不要で使用できます。
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GPSLogger.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 共有でCSVを他のアプリ（OneDrive など）に渡すためのFileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- GPS ロギング用 Foreground Service -->
        <service
            android:name=".service.LocationForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

    </application>

</manifest>
